# Copia este archivo como ".env" (sin ".example") y completa los valores.
# El archivo .env NUNCA se sube a GitHub: está en el .gitignore.
#
# Los datos de conexión de la base de datos PostgreSQL se leen de estas variables.

# --- Base de datos en la nube (Render Postgres) ---
# Host largo (External Database URL de Render, la parte entre "@" y "/"),
# nombre de la base al final, y sslmode=require.
DB_URL=jdbc:postgresql://<HOST-LARGO>.<region>-postgres.render.com:5432/<NOMBRE_BASE>?sslmode=require
DB_USER=<USUARIO>
DB_PASSWORD=<CONTRASENA>

# --- Alternativa: base de datos local ---
# Si solo defines DB_PASSWORD, se usa PostgreSQL local:
#   usuario "postgres" y base "studycards" en localhost:5432.
# DB_PASSWORD=<CONTRASENA_LOCAL>